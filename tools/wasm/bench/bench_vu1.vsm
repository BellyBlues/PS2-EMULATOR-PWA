; SPDX-FileCopyrightText: 2026 TabStationToo contributors
; SPDX-License-Identifier: MIT
;
; VU1 microprogram of the benchmark: transforms, lights and projects one batch of triangle-strip
; vertices, then sends them to the GS with XGKICK. It runs once per batch (MSCAL 0) and reads
; everything from the current double buffer (XTOP), laid out by bench.c:
;
;   0       x = vertex count n (integer)
;   1       GIF tag (PRIM, NLOOP = n, registers ST, RGBAQ, XYZ2)
;   2       ambient colour (rgb, 128 = 1.0) and alpha (w)
;   3..5    light rows: the base colour times the light direction's x, y and z in the mesh's space
;   6       screen offset (2048, 2048, 0, 0)
;   7..10   local-to-screen matrix, rows 0 to 3 (row vectors: v * M)
;   11..12  an A+D GIF tag and its TEX0 value: the texture this batch uses, sent ahead of the
;           primitives, as games switch textures inside their VU1 packets
;   13..    vertices, three quadwords each: position (xyz, w = 1), normal (xyz; w = 32768.0 for
;           the first two vertices of a strip, which becomes the XYZ2 ADC bit), texture (s, t, 1, 0)
;
; Colour = max(ambient + base * dot(normal, light), ambient): one accumulator chain.
; The matrix gives (x * fx, -y * fy, Zk, depth); dividing by depth gives the screen position and
; a depth value that grows towards the camera (the Z test is GEQUAL).
;
; Upper and lower instructions are paired and the loop is software-pipelined, as games write
; their VU1 code: each pass loads and transforms vertex i and starts its divide, and finishes and
; stores vertex i - 1, whose divide ran during the previous pass. The loop runs n + 1 times; the
; first pass stores a dummy vertex into the 3 quadwords after the input, and the TEX0 packet and
; the GIF tag go in over it after the loop. With 80 vertices the buffer is exactly full (496).

		.vu
		.align 4
		.global	BenchVU1_CodeStart
		.global	BenchVU1_CodeEnd
BenchVU1_CodeStart:
		NOP				xtop		VI02
		NOP				ilw.x		VI03, 0(VI02)
		NOP				lq		VF20, 1(VI02)
		NOP				lq		VF01, 2(VI02)
		NOP				lq		VF02, 3(VI02)
		NOP				lq		VF03, 4(VI02)
		NOP				lq		VF04, 5(VI02)
		NOP				lq		VF09, 6(VI02)
		NOP				lq		VF05, 7(VI02)
		NOP				lq		VF06, 8(VI02)
		NOP				lq		VF07, 9(VI02)
		NOP				lq		VF08, 10(VI02)
		NOP				lq		VF22, 11(VI02)
		NOP				lq		VF23, 12(VI02)
		NOP				iaddiu		VI04, VI02, 13
		NOP				iadd		VI05, VI03, VI03
		NOP				iadd		VI05, VI05, VI03
		NOP				iadd		VI05, VI05, VI04
		NOP				iaddiu		VI05, VI05, 2
		NOP				iaddiu		VI06, VI05, -2
		NOP				iaddiu		VI03, VI03, 1
vertexLoop:
		mulq.xyz	VF17, VF13, Q		lq		VF10, 0(VI04)
		mulq.xyz	VF18, VF12, Q		lq		VF11, 1(VI04)
		ftoi0		VF19, VF15		lq		VF12, 2(VI04)
		NOP				iaddiu		VI06, VI06, 3
		mulax		ACC, VF05, VF10x	iaddiu		VI04, VI04, 3
		madday		ACC, VF06, VF10y	sq		VF18, -3(VI06)
		maddaz		ACC, VF07, VF10z	sq		VF19, -2(VI06)
		maddw		VF13, VF08, VF00w	iaddi		VI03, VI03, -1
		add.xy		VF17, VF17, VF09	move.w		VF16, VF21
		mulaw		ACC, VF01, VF00w	NOP
		maddax		ACC, VF02, VF11x	NOP
		madday		ACC, VF03, VF11y	div		Q, VF00w, VF13w
		maddz		VF15, VF04, VF11z	NOP
		ftoi4.xyz	VF16, VF17		NOP
		ftoi0.w		VF21, VF11		NOP
		NOP				NOP
		max.xyz		VF15, VF15, VF01	ibne		VI03, VI00, vertexLoop
		NOP				sq		VF16, -1(VI06)
		NOP				sq		VF22, -2(VI05)
		NOP				sq		VF23, -1(VI05)
		NOP				sq		VF20, 0(VI05)
		NOP				iaddiu		VI07, VI05, -2
		NOP				xgkick		VI07
		NOP[E]				NOP
		NOP				NOP
		.align 4
BenchVU1_CodeEnd:
